---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { appStoreBadge, appsBySlug, companionApps } from "../../data/site";

const app = appsBySlug.foodscanner;
---

<BaseLayout
  title="Food Scanner"
  description="Food Scanner is an iPhone app with optional wearable companion support. AI-assisted nutrition overlays from food photos."
  path="/apps/foodscanner"
>
  <article class="container prose">
    <header class="page-header">
      <div class="page-header__brand">
        {
          app.icon && (
            <img
              class="page-header__icon"
              src={app.icon}
              width="72"
              height="72"
              alt={app.iconAlt || "Food Scanner"}
            />
          )
        }
        <div>
          <p class="page-header__kicker">iPhone · App Store</p>
          <h1 class="page-header__title">Food Scanner</h1>
        </div>
      </div>
      <p class="page-header__lead">
        Food Scanner is an iPhone app with optional wearable companion support.
        It also works standalone on iPhone.
      </p>
      {
        app.appStoreUrl && (
          <p class="page-header__actions">
            <a
              class="store-badge-link"
              href={app.appStoreUrl}
              rel="noopener noreferrer"
              aria-label={`Food Scanner — ${appStoreBadge.alt}`}
            >
              <img
                src={appStoreBadge.src}
                width={appStoreBadge.width}
                height={appStoreBadge.height}
                alt={appStoreBadge.alt}
              />
            </a>
          </p>
        )
      }
    </header>

    <p>
      The app turns a food photo into an AI-assisted nutrition overlay with
      estimated calories, macros, and concise pros and cons. Users can capture
      from the iPhone camera, choose a photo from the library, or send an image
      from the optional wearable companion.
    </p>

    <h2>Supported Modes and Models</h2>
    <ul>
      <li>Local iPhone Vision (default, on device)</li>
      <li>xAI Grok</li>
      <li>OpenAI</li>
      <li>Anthropic Claude</li>
      <li>Google Gemini / Gemma</li>
      <li>Ollama vision models</li>
      <li>PocketPal</li>
      <li>Custom OpenAI-compatible endpoints</li>
    </ul>

    <h2>Optional Wearable Companion (Google Glass XE)</h2>
    <p>
      The optional Google Glass XE companion captures a food image and sends it
      to the iPhone app over local Wi-Fi or iPhone Personal Hotspot. Analysis
      runs on iPhone, and results are displayed back on the companion display.
    </p>
    <p>
      <strong>Requires:</strong> Google Glass XE, ADB on a computer, and an
      iPhone Personal Hotspot. Connect Glass to the iPhone hotspot before
      opening Food Scanner.
    </p>

    <h3>Install path: this page → GitHub</h3>
    <ol>
      <li>
        Download the companion APK from the button below (or from the
        <a
          href="https://github.com/scalinghuman/experiments/releases/tag/glass-companions-v1.0.0"
          rel="noopener noreferrer">GitHub release</a
        >).
      </li>
      <li>
        Follow the
        <a href={companionApps.foodscanner.guideUrl} rel="noopener noreferrer"
          >Google Glass XE installation guide on GitHub</a
        >
        for ADB install, USB debugging, and hotspot setup.
      </li>
      <li>Open this iPhone app and confirm the connection indicator.</li>
      <li>
        On Glass, open the <strong>scan food</strong> command and
        <strong>tap</strong> the touchpad to launch — wait about one second,
        then tap again to capture a food photo.
      </li>
    </ol>
    <p>
      <strong>Do not rely on saying “Ok Glass.”</strong> Use the touchpad tap
      on the <strong>scan food</strong> Glass command.
    </p>
    <p class="page-header__actions">
      <a class="btn btn--secondary" href={companionApps.foodscanner.apkUrl}>
        Download Google Glass companion (APK)
      </a>
      <a href={companionApps.foodscanner.guideUrl} rel="noopener noreferrer">
        Installation guide on GitHub
      </a>
    </p>

    <h2>Notes</h2>
    <ul>
      <li>
        Nutrition values are AI estimates for general information only.
      </li>
      <li>
        The app is not medical advice and should not be used for diagnosis or
        treatment.
      </li>
    </ul>

    <div class="links-row">
      <a href="/privacy.html">Privacy Policy</a>
      <a href="/support.html">Support</a>
      <a href="/">Home</a>
    </div>
  </article>
</BaseLayout>
