---
import BaseLayout from "../layouts/BaseLayout.astro";
import { person } from "../data/site";

const rows = [
  {
    label: "Email",
    href: `mailto:${person.email}`,
    value: person.email,
    external: false,
  },
  {
    label: "GitHub profile",
    href: person.github,
    value: person.githubLabel,
    external: true,
  },
  {
    label: "LinkedIn",
    href: person.linkedin,
    value: "linkedin.com/in/srikanthab",
    external: true,
  },
  {
    label: "X",
    href: person.x,
    value: person.xLabel,
    external: true,
  },
] as const;
---

<BaseLayout
  title="Contact"
  description={`Contact ${person.name} about Scaling Human apps, personal experiments, feedback or rights concerns.`}
  path="/contact.html"
>
  <article class="container">
    <header class="page-header">
      <p class="page-header__kicker">Get in touch</p>
      <h1 class="page-header__title">Contact</h1>
      <p class="page-header__lead">
        A question about a project, feedback on an app, or an idea to share
        with {person.name}.
      </p>
    </header>

    <div class="person-card person-card--page">
      <div class="person-card__top">
        <img
          class="person-card__avatar"
          src="/assets/logos/scalinghuman-nn-face.jpg"
          width="48"
          height="48"
          alt=""
        />
        <div class="person-card__identity">
          <p class="person-card__name">{person.name}</p>
          <p class="person-card__role">Personal projects · Scaling Human</p>
        </div>
      </div>

      <dl class="contact-dl">
        {
          rows.map((row) => (
            <div class="contact-dl__row">
              <dt class="contact-dl__label">{row.label}</dt>
              <dd class="contact-dl__value">
                <a
                  href={row.href}
                  rel={row.external ? "noopener noreferrer" : undefined}
                >
                  {row.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <section class="contact-aside" aria-labelledby="app-support-heading">
      <h2 id="app-support-heading">App and project support</h2>
      <p>
        Start with the support hub for setup guides, compatibility notes and help
        for each project. When emailing about a problem, include the project name,
        device and operating-system version, and a short description of what happened.
      </p>
      <div class="links-row">
        <a class="btn btn--primary" href="/support.html">Find project help</a>
        <a href="/#projects">All projects</a>
      </div>
    </section>

    <section class="contact-aside" aria-labelledby="rights-heading">
      <h2 id="rights-heading">Rights concerns</h2>
      <p>
        For a concern about public material, email the affected URL, a brief
        description of the concern and your authority to act. Individual project
        pages include their own use and takedown notices.
      </p>
      <p><a href={`mailto:${person.email}?subject=Scaling%20Human%20rights%20concern`}>Email a rights concern</a></p>
    </section>
  </article>
</BaseLayout>

<style>
  .person-card__role,
  .contact-dl__label { color: var(--text-secondary); }
  .contact-aside + .contact-aside { margin-top: 2.5rem; }
  .contact-aside .links-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
</style>
