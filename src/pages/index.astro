---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperimentCard from "../components/ExperimentCard.astro";
import Tagline from "../components/Tagline.astro";
import { collection, experiments, person, tagline } from "../data/site";

const groups = [
  { status: "available", id: "available", title: "Available to try", description: "Apps, community tools, a family sideload build and a playable browser experiment. Each page describes who the project is for and how to use it." },
  { status: "development", id: "in-development", title: "In development", description: "Project pages share the scope and progress. App downloads are not available yet." },
] as const;
---

<BaseLayout
  title="Scaling Human"
  description={`${tagline}. Personal, noncommercial projects and community contributions with hardware, AI, apps, games and local computing.`}
  path="/"
>
  <section class="hero container">
    <img
      class="hero__artwork"
      src="/assets/logos/scalinghuman-neural-hero.png"
      width="985"
      height="700"
      alt="Neural network diagram connecting a human face to machine-learning layers"
    />
    <p class="hero__eyebrow">Hardware + AI</p>
    <h1 class="hero__title">Scaling Human</h1>
    <p class="hero__tagline">
      <Tagline />
    </p>
    <p class="hero__lead">
      Personal projects and community contributions with hardware, AI, apps, games and local computing.
      Built to learn how machines can extend human perception, memory, judgment
      and capability. Apps and notes are shared for free as they become useful.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#projects">See projects</a>
      <a
        class="btn btn--secondary"
        href={collection.github}
        rel="noopener noreferrer"
      >
        Explore the collection
      </a>
    </div>
  </section>

  <section
    class="section container"
    id="projects"
    aria-labelledby="projects-heading"
  >
    <!-- #work kept for older in-page links -->
    <div class="section__header" id="work">
      <span id="experiments" class="sr-only"></span>
      <h2 id="projects-heading">Projects and contributions</h2>
      <p>
        A noncommercial collection for learning, everyday life and the community. Each project
        has a page here and notes in the experiments repository. Support and
        privacy pages for published apps remain available on this site.
      </p>
    </div>

    <nav class="project-jumps" aria-label="Project groups">
      <a href="#available">Available to try</a>
      <a href="#in-development">In development</a>
      <a href={collection.notes}>All project notes ↗</a>
    </nav>

    {groups.map((group) => (
      <section class="project-group" id={group.id} aria-labelledby={`${group.id}-heading`}>
        <div class="project-group__header">
          <h3 id={`${group.id}-heading`}>{group.title}</h3>
          <p>{group.description}</p>
        </div>
        <div class:list={["card-grid", { "card-grid--3": group.status === "development" }]}>
          {experiments.filter((project) => project.availability === group.status).map((project) => (
            <ExperimentCard {...project} headingLevel={4} />
          ))}
        </div>
      </section>
    ))}

    <p class="section__note">
      Availability and source access differ by project. The project notes link
      to the downloads, code and license that are available for each project.
    </p>
  </section>

  <section class="section container connection" id="connection" aria-labelledby="connection-heading">
    <div class="section__header">
      <h2 id="connection-heading">Carbon and silicon, connected</h2>
      <p>Human experience and artificial intelligence can contribute different strengths.
        These experiments explore what becomes possible when we connect them.</p>
    </div>
    <figure class="connection__figure">
      <video controls muted playsinline loop preload="none" width="854" height="480"
        poster="/assets/connection/connection-poster.png"
        aria-label="Four-second abstract animation: dots converge, overlap and connect with a straight line"
        aria-describedby="connection-caption">
        <source src="/assets/connection/apple-intention-42-46.mp4" type="video/mp4" />
        <a href="/assets/connection/apple-intention-42-46.gif">View the four-second GIF</a>
      </video>
      <figcaption id="connection-caption">
        A visual reference: 0:42 to 0:46 of Apple’s <cite>Intention</cite> (2013),
        shared in <a href="https://x.com/NSJunXiu/status/2108756692741865746">Jun’s post</a>.
        The sequence reads “surprise,” “love,” and “connection.” The carbon and silicon
        interpretation is ours.
        <a href="/assets/connection/apple-intention-42-46.gif" download>Download the GIF</a>.
      </figcaption>
    </figure>
  </section>

  <section class="section container" aria-labelledby="collection-heading">
    <div class="section__header">
      <h2 id="collection-heading">Around the collection</h2>
      <p>Follow an experiment from its public page to its notes, or explore the people and code behind it.</p>
    </div>
    <div class="collection-links">
      <a href={collection.github}><strong>Experiments</strong><span>Project briefs, shared source and downloads ↗</span></a>
      <a href={collection.repositories}><strong>Scaling Human on GitHub</strong><span>Browse the public repositories ↗</span></a>
      <a href={person.github}><strong>{person.name}</strong><span>Personal profile and other interests ↗</span></a>
    </div>
  </section>

  {/* Products section reserved until work authorization / intentional launch. */}
</BaseLayout>

<style>
  .connection__figure { max-width: 42rem; margin: 1.5rem 0 0; }
  .connection__figure video { display: block; width: 100%; height: auto; border-radius: 1rem; background: #d2d2d2; }
  .connection__figure figcaption { margin-top: 1rem; font-size: 0.875rem; line-height: 1.65; color: var(--text-secondary, inherit); }
</style>
