---
import { appStoreBadge } from "../data/site";

interface Props {
  title: string;
  kicker?: string;
  description: string;
  href: string;
  cta?: string;
  briefUrl?: string;
  headingLevel?: 3 | 4;
  appStoreUrl?: string;
  appStoreLabel?: string;
  icon?: string;
  iconAlt?: string;
  previewImages?: { src: string; alt: string; width: number; height: number }[];
}

const {
  title,
  kicker = "Public project",
  description,
  href,
  cta = "Details",
  appStoreUrl,
  briefUrl,
  headingLevel = 3,
  icon,
  iconAlt = "",
  previewImages = [],
} = Astro.props;
const Heading = headingLevel === 4 ? "h4" : "h3";
---

<article class="card card--static">
  <div class="card__top">
    {
      icon && (
        <img
          class="card__icon"
          src={icon}
          width="56"
          height="56"
          alt={iconAlt || ""}
          loading="lazy"
        />
      )
    }
    <div class="card__top-text">
      <p class="card__kicker">{kicker}</p>
      <Heading class="card__title">
        <a class="card__title-link" href={href}>{title}</a>
      </Heading>
    </div>
  </div>
  <p class="card__body">{description}</p>
  {previewImages.length > 0 && (
    <a class="card__screenshots" href={href} aria-label={`${title}: view screenshots and gameplay details`}>
      {previewImages.map((image) => <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />)}
    </a>
  )}
  <div class="card__actions">
    {
      appStoreUrl && (
        <a
          class="card__store"
          href={appStoreUrl}
          rel="noopener noreferrer"
          aria-label={`${title}: ${appStoreBadge.alt}`}
        >
          <img
            class="card__store-badge"
            src={appStoreBadge.src}
            width={appStoreBadge.width}
            height={appStoreBadge.height}
            alt={appStoreBadge.alt}
            loading="lazy"
          />
        </a>
      )
    }
    <a class="card__cta" href={href}>{cta} →</a>
    {briefUrl && <a class="card__notes" href={briefUrl}>Project notes ↗</a>}
  </div>
</article>

<style>
  .card__screenshots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 4px 0 24px; padding: 12px; background: #f6f0dd; border: 1px solid var(--border); border-radius: 14px; }
  .card__screenshots img { display: block; width: 100%; height: auto; border-radius: 8px; }
  .card__screenshots:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
</style>
