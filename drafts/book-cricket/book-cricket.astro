---
import BaseLayout from "../../src/layouts/BaseLayout.astro";
// Public prelaunch page. Add the approved listing URL after App Review.
const appStoreUrl: string | null = null;
const nearbyReady = true; // Physical nearby multiplayer confirmed by the user on 7 October 2026.
const media = "/assets/apps/book-cricket";
const gallery = [
  { file: "shelf.png", title: "Pick your book", text: "Six offline editions, led by 1,000 Cricket Facts by S Ballani.", alt: "Book Cricket shelf with six books and single-player and multiplayer choices" },
  { file: "setup.png", title: "Call the toss", text: "Choose who bats first and score from either page or the conventional left page.", alt: "Single player setup showing batting order and scoring-page options" },
  { file: "closed-book.png", title: "Close. Open. Play.", text: "The book is your bat. Every new opening resolves one ball.", alt: "A closed book centered beneath the Book Cricket scorecard" },
  { file: "six.png", title: "Send it over the rope", text: "Runs play out above the pages, then move into your scorecard.", alt: "A six-run cricket replay over readable book pages" },
  { file: "wicket.png", title: "Watch the bails fly", text: "A zero means a wicket. The batsman misses; the ball finds the stumps.", alt: "A bowled wicket replay with the ball striking the stumps" },
  { file: "chase.png", title: "Chase the target", text: "Five overs, five wickets and one score to beat.", alt: "Second innings with Player 2 chasing a target of 21" },
  { file: "reader.png", title: "Read between innings", text: "Search facts, explore topics and follow references when curiosity takes over.", alt: "Searchable offline cricket facts reader credited to S Ballani" },
  { file: "left-page.png", title: "Keep your school rules", text: "Left page only gives you 2, 4, 6 or 8 runs. Zero is still out.", alt: "Same-phone match setup with Left page only selected" },
];
const chapters = [
  { time: 0, stamp: "0:00", label: "Pick a book" },
  { time: 4, stamp: "0:04", label: "Set up a match" },
  { time: 9, stamp: "0:09", label: "Open the book" },
  { time: 12, stamp: "0:12", label: "Score runs" },
  { time: 22, stamp: "0:22", label: "Lose a wicket" },
  { time: 32, stamp: "0:32", label: "Chase the target" },
  { time: 40, stamp: "0:40", label: "Explore facts" },
];
---
<BaseLayout title="Book Cricket" description="The classroom was the stadium. Play nostalgic book cricket on iPhone Duo or a supported iPhone, and learn from 1,000 Cricket Facts by S Ballani." path="/apps/book-cricket">
  <article class="container book-cricket-page">
    <div class="intro-grid">
    <header class="page-header">
      <div class="page-header__brand">
        <img class="page-header__icon" src={`${media}/icon.png`} width="88" height="88" alt="Book Cricket: red cricket ball, stumps and an open book in an India-inspired palette" />
        <div><p class="page-header__kicker">iPhone Duo · iPhone · Free at launch</p><h1 class="page-header__title">Book Cricket</h1></div>
      </div>
      <p class="nostalgia">The classroom was the stadium.</p>
      <p class="page-header__lead">A book. A page number. A whole cricket match before the bell. Bring the Indian schoolyard game of the 90s to your phone—with a little learning between every ball.</p>
      <div class="page-header__actions actions">
        {appStoreUrl ? <a class="btn btn--primary" href={appStoreUrl} rel="noopener noreferrer">Download free on the App Store</a> : <span class="launch-note">Coming soon on the App Store</span>}
        <a class="btn btn--secondary" href="#walkthrough">Watch the walkthrough ↓</a>
      </div>
    </header>

    <figure class="hero-shot">
      <a href={`${media}/nostalgia-artwork.png`} aria-label="View the Book Cricket nostalgia illustration"><img src={`${media}/nostalgia-artwork.png`} width="1672" height="941" fetchpriority="high" alt="90s classroom cricket illustration: a stitched red cricket ball beside an open book, page 26 with only its last digit 6 circled, facing page 27" /></a>
      <figcaption>Page 26. Last digit 6. A six before the bell.</figcaption>
    </figure>

    </div>

    <section class="ritual" aria-labelledby="ritual-title">
      <div><p class="eyebrow">One familiar ritual</p><h2 id="ritual-title">The fold is the spine.</h2></div>
      <div><p>On <strong>iPhone Duo</strong>, close the phone and partially or fully open it. That first opening plays one ball; closing sets up the next.</p><p>On a <strong>traditional iPhone</strong>, tap the book control to simulate closing and opening. The cover turns while your scorecard stays in place.</p></div>
    </section>

    <section id="walkthrough" class="section-block" aria-labelledby="walkthrough-title">
      <p class="eyebrow">46 seconds, from shelf to scorecard</p><h2 id="walkthrough-title">Take it for an innings.</h2>
      <p>A silent walkthrough of the app, with captions and chapter shortcuts. Recorded in the iPhone Duo simulator.</p>
      <video id="book-cricket-video" class="walkthrough" controls playsinline preload="none" poster={`${media}/open-pages.png`} width="1280" height="900" aria-label="Book Cricket walkthrough: choose a book, set up a match, score runs, lose a wicket, chase and read facts">
        <source src={`${media}/walkthrough.mp4`} type="video/mp4" />
        <track kind="captions" src={`${media}/walkthrough.vtt`} srclang="en" label="English instructions" default />
        <p>Your browser cannot play this video. <a href={`${media}/walkthrough.mp4`}>Download the walkthrough</a>, or read the steps below.</p>
      </video>
      <div class="chapter-links" aria-label="Walkthrough chapters">{chapters.map((chapter) => <button type="button" data-video-time={chapter.time}><span>{chapter.stamp}</span> {chapter.label}</button>)}</div>
      <ol class="walkthrough-steps">
        <li><strong>Pick a book and a mode.</strong> Play the computer, pass one phone between two players, or invite a nearby player.</li>
        <li><strong>Choose the toss and scoring page.</strong> Either page is the default; left page only recreates conventional even-page play.</li>
        <li><strong>Close, then open.</strong> Read the highlighted last digit: 1–9 score runs; 0 costs a wicket.</li>
        <li><strong>Finish the innings and chase.</strong> Six balls make an over. Beat the first side’s total within five overs and five wickets.</li>
        <li><strong>Keep reading.</strong> Open “Read facts” on the home screen to search the learning books and their references.</li>
      </ol>
    </section>

    <section class="section-block" aria-labelledby="modes-title">
      <p class="eyebrow">Your break. Your match.</p><h2 id="modes-title">Play a quick five.</h2>
      <div class="mode-grid">
        <div class="mode-card"><span>01</span><h3>You vs computer</h3><p>Bat first or field first. The computer plays its innings, then you chase or defend.</p></div>
        <div class="mode-card"><span>02</span><h3>One phone, two players</h3><p>Pass the book between friends. One shared screen keeps the match and target in view.</p></div>
        <div class="mode-card"><span>03</span><h3>Nearby phones</h3><p>{nearbyReady ? "One hosts, the other joins and accepts the match. Play directly between nearby iPhones without an account or hosted match server. Allow local-network access on both phones and keep the app open." : "Direct play between nearby iPhones is being checked for launch. Solo and same-phone matches work offline."}</p></div>
      </div>
      <p class="quiet-note">No accounts, ads or in-app purchases. Hosted online multiplayer is a future feature.</p>
    </section>

    <section class="section-block" aria-labelledby="previews-title">
      <p class="eyebrow">A ball, a replay, a little reading</p><h2 id="previews-title">See the book come alive.</h2>
      <p>Two 28-second previews recorded in the app: open the book, hit a six, lose a wicket and explore the facts shelf.</p>
      <div class="device-previews">
        {[
          { device: "duo", title: "On iPhone Duo", text: "Your fold becomes the book’s spine." },
          { device: "iphone", title: "On your iPhone", text: "Tap to close and open the book. The scorecard stays put." },
        ].map((preview) => <figure><h3>{preview.title}</h3><video controls playsinline preload="none" poster={`${media}/${preview.device}-preview-poster.png`} width="886" height="1920" aria-label={`${preview.title}: Book Cricket gameplay preview`}><source src={`${media}/${preview.device}-preview.mp4`} type="video/mp4" /><track kind="captions" src={`${media}/gameplay-preview.vtt`} srclang="en" label="English instructions" default /><p><a href={`${media}/${preview.device}-preview.mp4`}>Download the gameplay preview</a>.</p></video><figcaption>{preview.text}</figcaption></figure>)}
      </div>
    </section>

    <section class="section-block" aria-labelledby="gallery-title">
      <p class="eyebrow">Inside the app</p><h2 id="gallery-title">Paper, ink and a little cricket.</h2>
      <p>Actual app screens. Select any screenshot to see it at full size.</p>
      <div class="screenshot-grid">{gallery.map((shot) => <figure><a href={`${media}/${shot.file}`} aria-label={`View full-size screenshot: ${shot.title}`}><img src={`${media}/${shot.file}`} width="1398" height="2034" loading="lazy" decoding="async" alt={shot.alt} /></a><figcaption><h3>{shot.title}</h3><p>{shot.text}</p></figcaption></figure>)}</div>
    </section>

    <section class="books-section section-block" aria-labelledby="books-title">
      <p class="eyebrow">A shelf worth opening</p><h2 id="books-title">One thousand reasons to turn a page.</h2>
      <p><strong>1,000 Cricket Facts by S Ballani</strong> is your default book: Indian legends, women’s cricket, World Cups, history, equipment and the Laws. Every numbered page holds one complete fact.</p>
      <p>Follow it into <strong>100 Space Facts</strong>, then revisit a classic story or Faraday’s science lectures. All six books are bundled for offline reading and play. Fact references open in your browser when you’re online.</p>
      <p>The classic editions include their full source licence and an intact original text you can save or share for free from the app.</p>
      <ul class="book-list"><li>1,000 Cricket Facts <span>S Ballani</span></li><li>100 Space Facts <span>Backbench Club · NASA references</span></li><li>The Time Machine <span>H. G. Wells</span></li><li>Frankenstein <span>Mary Shelley · 1831 edition</span></li><li>The Lost World <span>Arthur Conan Doyle</span></li><li>The Chemical History of a Candle <span>Michael Faraday · 1908 impression</span></li></ul>
    </section>

    <section class="flat-phone section-block" aria-labelledby="iphone-title">
      <div><p class="eyebrow">The same book on a flat phone</p><h2 id="iphone-title">Your iPhone can play too.</h2><p>Supported iPhones running iOS 17 or later have a simulated book control. Only the book cover turns. Runs, wickets and the current over stay visible around it.</p></div>
      <div class="phone-shots"><img src={`${media}/iphone-closed.png`} width="1206" height="2622" loading="lazy" alt="Book Cricket closed cover and simulated fold control on a traditional iPhone" /><img src={`${media}/iphone-open.png`} width="1206" height="2622" loading="lazy" alt="Open cricket facts pages and scorecard on a traditional iPhone" /></div>
    </section>

    <section class="section-block questions" aria-labelledby="questions-title">
      <h2 id="questions-title">Before the next ball</h2>
      <details><summary>Why do I sometimes score from the right page?</summary><p>The default rule randomly selects either page, letting every digit from 0 through 9 occur. The highlighted digit shows which page counted. Choose Left page only before starting if you prefer even-page play.</p></details>
      <details><summary>Do 7, 8 and 9 really count as runs?</summary><p>Yes. Book Cricket uses the selected page’s final digit: 1–9 score their face value, and 0 is out. Left-page-only play offers 2, 4, 6 and 8. These are book-cricket rules; the replay celebrates each page result.</p></details>
      <details><summary>Can I play without the internet?</summary><p>Solo, same-phone matches and the bundled books work offline. Reference links and support email need an internet connection. Nearby play uses a direct local connection; hosted online matches are a future feature.</p></details>
      <details><summary>Where does my data go?</summary><p>The app has no analytics, advertising or accounts. Nearby matches share player names and match moves directly with the other phone. They are not sent to a developer-run server. Read the <a href="/apps/book-cricket/privacy">privacy policy</a> for details.</p></details>
    </section>
    <div class="links-row"><a href="/apps/book-cricket/privacy">Privacy Policy</a><a href="/apps/book-cricket/support">Book Cricket Support</a><a href="/">Scaling Human</a></div>
    <p class="quiet-note app-copyright">© 2026 ScalingHuman AI · Cricket facts by S Ballani.</p>
  </article>
</BaseLayout>
<script>
  const video = document.querySelector<HTMLVideoElement>("#book-cricket-video");
  document.querySelectorAll<HTMLButtonElement>("[data-video-time]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!video) return;
      video.currentTime = Number(button.dataset.videoTime);
      void video.play().catch(() => video.focus());
      video.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
    });
  });
</script>
<style>
  .book-cricket-page { --book-green: #214f40; --book-ink: #243d32; --book-paper: #f6f0dd; }
  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 35px; align-items: center; }
  .intro-grid .page-header { border: none; margin: 0; padding: 0; }
  .book-cricket-page .page-header__icon { width: 88px; height: 88px; border-radius: 22%; }
  .nostalgia { font-family: Georgia, serif; font-weight: 700; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.08; color: var(--text); margin: 1.5rem 0 1rem; max-width: 800px; }
  .page-header__lead { font-size: 1.15rem; max-width: 730px; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .launch-note { font-size: .95rem; font-weight: 600; color: var(--text-secondary); padding: .65rem 0; }
  figure { margin: 0; }
  .hero-shot { background: var(--book-paper); border: 1px solid var(--border-strong); border-radius: 18px; overflow: hidden; }
  .hero-shot img { width: 100%; height: auto; }
  .hero-shot figcaption { color: var(--book-ink); padding: 16px 20px; font-size: .9rem; }
  .ritual { display: grid; grid-template-columns: .9fr 1.1fr; gap: 48px; padding: 55px 0 30px; }
  .eyebrow { font: 600 .73rem var(--font-mono); text-transform: uppercase; letter-spacing: .12em; color: var(--text-tertiary); margin-bottom: 12px; }
  .section-block { margin-top: 50px; padding-top: 35px; border-top: 1px solid var(--border); scroll-margin-top: 80px; }
  .section-block > p { max-width: 760px; }
  .walkthrough { width: 100%; height: auto; max-height: 680px; border: 1px solid var(--border-strong); border-radius: 16px; background: var(--book-paper); margin-top: 22px; display: block; }
  .chapter-links { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 22px; }
  .chapter-links button { font: inherit; font-size: .83rem; padding: 9px 11px; border: 1px solid var(--border-strong); background: var(--bg-elevated); color: var(--text); border-radius: 8px; cursor: pointer; }
  .chapter-links span { color: var(--text-secondary); font-family: var(--font-mono); margin-right: 4px; }
  button:focus-visible, summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .walkthrough-steps { max-width: 800px; font-size: .96rem; }
  .walkthrough-steps li { margin-bottom: 12px; }
  .device-previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: 24px; }
  .device-previews video { display: block; width: 100%; height: auto; max-height: 640px; background: var(--book-paper); border: 1px solid var(--border-strong); border-radius: 16px; }
  .device-previews h3 { margin-bottom: 12px; }
  .device-previews figcaption { font-size: .9rem; margin-top: 12px; }
  .app-copyright { margin: 24px 0 0; }
  .mode-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 24px 0; }
  .mode-card { background: var(--bg-subtle); border-radius: 14px; padding: 25px; }
  .mode-card span { font: 600 .8rem var(--font-mono); color: var(--text-tertiary); }
  .mode-card h3 { margin: 13px 0 10px; font-size: 1.1rem; }
  .mode-card p { font-size: .92rem; }
  .quiet-note { font-size: .9rem; color: var(--text-tertiary); }
  .screenshot-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 22px; margin-top: 25px; }
  .screenshot-grid img { border: 1px solid var(--border-strong); border-radius: 12px; width: 100%; height: auto; background: var(--book-paper); }
  .screenshot-grid figcaption { padding-top: 13px; }
  .screenshot-grid h3 { font-size: 1.02rem; margin-bottom: 6px; }
  .screenshot-grid p { font-size: .9rem; margin: 0; }
  .book-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; list-style: none; padding: 0; margin-top: 24px; }
  .book-list li { border-top: 1px solid var(--border); padding: 14px 0; color: var(--text); font-weight: 600; font-size: .98rem; }
  .book-list span { display: block; font-weight: 400; font-size: .85rem; color: var(--text-secondary); margin-top: 4px; }
  .flat-phone { display: grid; grid-template-columns: 1fr 1.1fr; gap: 35px; align-items: center; }
  .phone-shots { display: flex; gap: 16px; min-width: 0; }
  .phone-shots img { width: calc(50% - 8px); height: auto; border-radius: 16px; border: 1px solid var(--border-strong); }
  .questions details { padding: 18px 0; border-bottom: 1px solid var(--border); }
  .questions summary { font-weight: 600; color: var(--text); cursor: pointer; }
  .questions details p { font-size: .96rem; margin: 12px 0 0; max-width: 780px; }
  .links-row { display: flex; flex-wrap: wrap; gap: 16px 24px; font-size: .92rem; margin-top: 40px; padding-top: 25px; border-top: 1px solid var(--border); }
  @media(max-width: 700px) { .intro-grid { grid-template-columns: 1fr; gap: 28px; } .ritual, .flat-phone { grid-template-columns: 1fr; gap: 15px; } .mode-grid, .device-previews { grid-template-columns: 1fr; } .screenshot-grid { grid-template-columns: 1fr; } .book-list { grid-template-columns: 1fr; } .section-block { margin-top: 35px; } .nostalgia { font-size: 2.3rem; } .phone-shots { max-width: 430px; } }
  @media(max-width: 500px) {
    :global(body:has(.book-cricket-page)) { --header-h: 88px; }
    :global(body:has(.book-cricket-page) .site-header__inner) { flex-direction: column; align-items: flex-start; justify-content: center; gap: 8px; }
    :global(body:has(.book-cricket-page) .nav) { gap: 18px; }
    .page-header__brand { align-items: flex-start; }
    .page-header__kicker { font-size: .72rem; }
  }
</style>
